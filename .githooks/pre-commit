#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# 提交闸门:三语种 .strings key 一致 + SwiftFormat lint(无需 xcodebuild)。
# 版本号不再随提交自动递增;发布前手动运行 `make bump-version`。
make -C "$REPO_ROOT" --no-print-directory localization-check LOCALIZATION_FLAGS=--quiet
exec make -C "$REPO_ROOT" --no-print-directory format-check
