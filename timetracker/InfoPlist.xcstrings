    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Tracker reads workouts and sleep from Apple Health to show them on your timeline and in analysis. It keeps an encrypted, read-only cache on this device for incremental refresh and export. Personal Health records never enter the app's iCloud database; Clear All deletes the cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间追踪会从“Apple 健康”读取运动和睡眠记录，并显示在时间线和分析中。App 会在本机保留加密、只读缓存，用于增量刷新和导出。个人健康记录绝不会进入本 App 的 iCloud 数据库；“清除全部数据”会删除该缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間追蹤會從「Apple 健康」讀取運動與睡眠記錄，並顯示在時間軸和分析中。App 會在本機保留加密、唯讀快取，用於增量更新和匯出。個人健康記錄絕不會進入本 App 的 iCloud 資料庫；「清除全部資料」會刪除該快取。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
