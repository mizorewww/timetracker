    "dialog.resetData.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes tasks, time records, pomodoro runs, countdowns, inbox items, categories, synced preferences, the local LLM API key, and this device’s automatic-suggestion consent. If iCloud sync is enabled, the deletion may sync to iCloud. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会永久删除任务、时间记录、番茄钟、倒计时、收件箱内容、分类、已同步设置、本机保存的 LLM API 密钥，以及此设备上的自动建议授权。如果已开启 iCloud 同步，删除可能会同步到 iCloud。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除任務、時間記錄、番茄鐘、倒數日、收件匣內容、分類、已同步設定、本機儲存的 LLM API 金鑰，以及此裝置上的自動建議同意狀態。如果已開啟 iCloud 同步，刪除可能會同步到 iCloud。此操作無法復原。"
          }
        }
      }
    },
    "dialog.resetData.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
