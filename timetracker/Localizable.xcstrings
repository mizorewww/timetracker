    "settings.displayTiming.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When several tasks run at once, actual time counts clock time once. Total task time adds each task separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个任务同时运行时，实际时间只计算真实经过的时间；累计时间会把每个任务分别相加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個任務同時執行時，實際時間只計算真實經過的時間；累計時間會把每個任務分別相加。"
          }
        }
      }
    },
    "settings.displayTiming.systemAppearanceFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Tracker follows the system appearance. When several tasks run at once, actual time counts clock time once while total time adds every task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间追踪器跟随系统外观。多个任务同时计时时，实际时间只计算一次，累计时间会把每个任务分别相加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間追蹤器會跟隨系統外觀。多個任務同時計時時，實際時間只計算一次，累計時間會把每個任務分別相加。"
          }
        }
      }
    },
