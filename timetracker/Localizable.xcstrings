        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将零散事项快速记录到时间追踪的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將零散事項快速記錄到時間追蹤的收件匣。"
          }
        }
      }
    },
