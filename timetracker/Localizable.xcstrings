    "settings.llm.prompt.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These instructions sync with your app data and are sent to your configured endpoint when the corresponding AI feature runs. Do not include passwords or API keys. Saving an empty editor restores that feature’s default instructions. The fixed response format and validation rules always remain in effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些指令会随应用数据同步，并在对应 AI 功能运行时发送到你配置的 endpoint。请勿填写密码或 API Key。清空编辑器并保存后会恢复该功能的默认指令；固定响应格式与验证规则始终有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些指令會隨 App 資料同步，並在對應 AI 功能執行時傳送到你設定的 endpoint。請勿填寫密碼或 API Key。清空編輯器並儲存後會恢復該功能的預設指令；固定回應格式與驗證規則始終有效。"
          }
        }
      }
    },
