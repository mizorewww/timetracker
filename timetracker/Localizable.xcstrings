        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製診斷資訊"
          }
        }
      }
    },
    "persistence.ephemeral.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Tracker opened a temporary in-memory store only to show this recovery screen. Editing and timers are disabled because temporary changes would disappear. Close the app, resolve the storage problem, and reopen it. Details: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间追踪仅打开了临时内存存储以显示此恢复界面。编辑和计时已被禁用，因为临时更改会在退出后消失。请关闭 App、解决存储问题后重新打开。详情：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間追蹤僅開啟暫時記憶體儲存空間以顯示此復原畫面。編輯與計時已停用，因為暫時變更會在結束後消失。請關閉 App、解決儲存問題後重新開啟。詳細資料：%@"
          }
        }
      }
    },
    "persistence.ephemeral.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persistent storage is unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持久化存储不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持久化儲存空間無法使用"
          }
        }
      }
    },
