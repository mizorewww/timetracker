    "forecast.estimatedTotal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
