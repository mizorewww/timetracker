    "analytics.overlap.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each row separates the wall-clock window from extra Gross Time. With N concurrent records, excess is (N − 1) × the window length."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行分别显示真实时段和多计入的累计时间。N 条记录并发时，超额 =（N − 1）× 时段长度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每列分別顯示真實時段和多計入的累計時間。N 筆記錄並行時，超額 =（N − 1）× 時段長度。"
          }
