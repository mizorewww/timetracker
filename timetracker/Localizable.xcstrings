    "aiTaskPlan.destructive.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This plan includes an archive, deletion, or progress reset. Review the affected paths before continuing. The entire batch is still applied atomically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此计划包含归档、删除或进度重置。继续前请检查受影响的路径。整批更改仍会原子应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此計畫包含封存、刪除或進度重設。繼續前請檢查受影響的路徑。整批變更仍會以原子方式套用。"
          }
        }
      }
    },
