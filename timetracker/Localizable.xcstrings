    "analytics.glossary.example.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task A and Task B both run from 9:00 to 9:30. Gross Time is 1h, Wall Time is 30m, and Overlap Excess is 30m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务 A 和任务 B 都从 9:00 运行到 9:30：累计时间为 1 小时，实际时间为 30 分钟，并发超额为 30 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務 A 和任務 B 都從 9:00 執行到 9:30：累計時間為 1 小時，實際時間為 30 分鐘，並行超額為 30 分鐘。"
          }
        }
      }
    },
    "analytics.glossary.example.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: two timers at once"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：两个计时器同时运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例：兩個計時器同時執行"
          }
        }
      }
    },
    "analytics.glossary.gross": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the duration of every task timer, including timers that overlap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每个任务计时器的时长都相加，包括相互重叠的计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把每個任務計時器的時長都相加，包括互相重疊的計時。"
          }
        }
      }
    },
    "analytics.glossary.gross.calculation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculation: add every timer duration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算：逐个相加所有计时器时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算：逐個相加所有計時器時長。"
          }
        }
      }
    },
    "analytics.glossary.overlap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how much time Gross counts more than once because timers overlap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表示累计时间因计时重叠而被重复计算了多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表示累計時間因計時重疊而被重複計算了多少。"
          }
        }
      }
    },
    "analytics.glossary.overlap.calculation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculation: Gross Time − Wall Time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算：累计时间 − 实际时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算：累計時間 − 實際時間。"
          }
        }
      }
    },
    "analytics.glossary.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gross, Wall, and Overlap answer different questions when timers run at the same time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个计时器同时运行时，累计时间、实际时间和并发超额回答的是不同问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多個計時器同時執行時，累計時間、實際時間和並行超額回答的是不同問題。"
          }
        }
      }
    },
    "analytics.glossary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "术语"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "術語"
          }
        }
      }
    },
    "analytics.glossary.wall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts the real clock time covered by one or more timers. Overlapping intervals count once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只计算至少有一个计时器运行的真实钟表时间；重叠时段只算一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只計算至少有一個計時器執行的真實鐘錶時間；重疊時段只算一次。"
          }
        }
      }
    },
    "analytics.glossary.wall.calculation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculation: merge overlapping intervals, then add their durations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算：合并所有重叠时段，再相加时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算：合併所有重疊時段，再相加時長。"
          }
        }
      }
    },
    "analytics.gross.footnote": {
      "extractionState": "manual",
