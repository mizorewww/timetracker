    "home.weeklyGross.emptyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a task and its Gross and Wall Time will appear here by day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始一个任务后，这里会按天显示累计时间和实际时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始一個任務後，這裡會按天顯示累計時間和實際時間。"
          }
        }
      }
    },
    "home.weeklyGross.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day compares Gross Time, the sum of every task timer, with Wall Time, where overlaps count once. If two timers overlap for 30 minutes, Gross Time increases by 60 minutes while Wall Time increases by 30 minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天同时比较累计时间与实际时间：累计时间会相加所有任务计时器，实际时间会合并重叠部分。若两个计时器重叠 30 分钟，累计时间增加 60 分钟，实际时间增加 30 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天同時比較累計時間與實際時間：累計時間會相加所有任務計時器，實際時間會合併重疊部分。若兩個計時器重疊 30 分鐘，累計時間增加 60 分鐘，實際時間增加 30 分鐘。"
          }
        }
      }
    },
    "home.weeklyGross.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Week’s Time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
