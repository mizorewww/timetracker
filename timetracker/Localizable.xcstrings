    "dialog.clearDemo.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes tasks, time records, and pomodoros created by demo data. User-created records are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除由演示数据生成的任务、时间记录和番茄钟，不会主动删除你手动创建的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除由示範資料產生的任務、時間記錄和番茄鐘，不會主動刪除你手動建立的記錄。"
          }
        }
      }
    },
