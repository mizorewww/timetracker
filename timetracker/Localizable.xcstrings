    "persistence.diagnostics.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Tracker persistence diagnostics\nStatus: %@\nMessage: %@\nStorage mode: %@\nStore location: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间追踪持久化诊断\n状态：%@\n信息：%@\n存储模式：%@\n存储位置：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間追蹤持久化診斷\n狀態：%@\n資訊：%@\n儲存模式：%@\n儲存位置：%@"
          }
        }
      }
    },
    "persistence.diagnosticsCopied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
