            "value": "預估"
          }
        }
      }
    },
    "forecast.explainer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an Estimate to get a forecast immediately. Otherwise, add checklist items, complete at least one, and track time. Completed items set the pace; history estimates days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动设置预计时长即可立即获得预测。否则，请添加清单项、至少完成一项并记录时间；已完成项决定平均进度，历史记录用于估算天数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動設定預估時長即可立即取得預測。否則，請新增清單項、至少完成一項並記錄時間；已完成項目決定平均進度，歷史記錄用於估算天數。"
          }
        }
      }
    },
    "forecast.explainer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How this forecast works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个预测怎么算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個預測怎麼算"
          }
        }
      }
    },
    "forecast.historyPace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History Pace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史节奏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史節奏"
          }
        }
      }
    },
    "forecast.historyPaceFormat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/day across %d tracked days"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日均 %@，基于 %d 个记录日"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日均 %@，基於 %d 個記錄日"
          }
        }
      }
    },
    "forecast.info.children.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a parent has one forecastable child, the child is shown directly. If several children can be forecast, the parent shows their combined remaining time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果父任务只有一个可以预测的子任务，会直接显示那个子任务。如果多个子任务都可以预测，父任务会显示它们的合计剩余时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果父任務只有一個可以預測的子任務，會直接顯示那個子任務。如果多個子任務都可以預測，父任務會顯示它們的合計剩餘時間。"
          }
        }
      }
    },
    "forecast.info.children.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parent and child tasks"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "父任务和子任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "父任務和子任務"
          }
        }
      }
    },
    "forecast.info.example.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task has 4 checklist items. You completed 1 item and tracked 30m, so the remaining 3 items are estimated at about 1h 30m. When all 4 are done, remaining time becomes 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个任务有 4 个清单项。你完成了 1 项并记录了 30 分钟，那么剩下 3 项预计约 1 小时 30 分钟。4 项全部完成后，剩余时间就是 0。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個任務有 4 個清單項。你完成了 1 項並記錄了 30 分鐘，那麼剩下 3 項預計約 1 小時 30 分鐘。4 項全部完成後，剩餘時間就是 0。"
          }
        }
      }
    },
    "forecast.info.example.remaining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 1h 30m left"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约剩余 1h 30m"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "約剩餘 1h 30m"
          }
        }
      }
    },
    "forecast.info.example.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例"
          }
        }
      }
    },
    "forecast.info.formula.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each checklist item is treated equally. The app divides tracked time by completed items, then multiplies that average by unfinished items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个清单项第一版按相同权重处理。应用会用已记录时间除以已完成清单项数量，再用这个平均值乘以未完成清单项数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個清單項第一版按相同權重處理。App 會用已記錄時間除以已完成清單項數量，再用這個平均值乘以未完成清單項數量。"
          }
        }
      }
    },
    "forecast.info.formula.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How hours are estimated"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余小时怎么算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘小時怎麼算"
          }
        }
      }
    },
    "forecast.info.history.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping completed checklist items preserves the progress sample used for estimates. Deleting them can make forecasts unavailable or less useful."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成清单项是估算用的进度样本。删除它们可能让预测不可用，或让结果变得不稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成清單項是估算用的進度樣本。刪除它們可能讓預測不可用，或讓結果變得不穩定。"
          }
        }
      }
    },
    "forecast.info.history.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why completed items matter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么要保留已完成项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼要保留已完成項"
          }
        }
      }
    },
    "forecast.info.requirements.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A manual Estimate provides a forecast immediately. Without one, a task needs checklist items, at least one completed item, and tracked time. Time Tracker shows what is missing instead of guessing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动设置预计时长即可立即生成预测。未设置时，任务需要有清单、至少完成一项并记录过时间；Time Tracker 会提示缺少的条件，而不是直接猜测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動設定預估時長即可立即產生預測。未設定時，任務需要有清單、至少完成一項並記錄過時間；Time Tracker 會提示缺少的條件，而不是直接猜測。"
          }
        }
      }
    },
    "forecast.info.requirements.title": {
      "extractionState": "manual",
      "localizations": {
