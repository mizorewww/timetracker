    "settings.archivedTasks.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived tasks stay out of task lists and timers until you unarchive them. When both a parent and subtask are archived, unarchive the parent first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档任务不会出现在任务列表和计时器中，取消归档后才会恢复。如果父任务和子任务都已归档，请先取消归档父任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存任務不會出現在任務列表和計時器中，取消封存後才會恢復。如果父任務和子任務都已封存，請先取消封存父任務。"
