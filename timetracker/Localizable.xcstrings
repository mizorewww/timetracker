    "settings.llm.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic suggestions are off by default on every device. When enabled, inbox text, checklist text, and relevant task names and paths are sent to your configured OpenAI-compatible endpoint. Fetching models is always a manual request. The API key stays in this device's Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备默认关闭自动建议。开启后，收件箱文本、清单文本及相关任务名称和路径会发送到你配置的 OpenAI 兼容 endpoint。拉取模型始终需要手动操作；API Key 只保存在本机钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每部裝置預設關閉自動建議。開啟後，收件匣文字、清單文字及相關任務名稱和路徑會傳送到你設定的 OpenAI 相容 endpoint。擷取模型一律需要手動操作；API Key 只保存在本機鑰匙圈。"
          }
        }
      }
    },
