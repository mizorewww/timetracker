    "settings.keyboardShortcuts.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts work while Time Tracker is active. New Task and Settings keep their standard shortcuts. Unassigned actions can be recorded here. Ordinary keys require Command, Option, or Control; function keys can be used alone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键仅在 Time Tracker 位于前台时生效。“新建任务”和“设置”保留系统标准快捷键；未分配的操作可在此录制。普通按键需配合 Command、Option 或 Control；功能键可单独使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速鍵僅在 Time Tracker 位於前景時生效。「新增任務」和「設定」保留系統標準快速鍵；未分配的操作可在此錄製。一般按鍵需配合 Command、Option 或 Control；功能鍵可單獨使用。"
          }
        }
      }
    },
