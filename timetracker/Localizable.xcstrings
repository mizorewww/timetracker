    "liveActivity.settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A running timer can appear on the Lock Screen. Dynamic Island is available only on supported iPhone models; iOS decides when each system surface is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在运行的计时器可显示在锁定屏幕上。灵动岛仅限支持的 iPhone 机型；具体显示位置由 iOS 决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行的計時器可顯示在鎖定畫面上。動態島僅限支援的 iPhone 機型；具體顯示位置由 iOS 決定。"
          }
        }
      }
    },
