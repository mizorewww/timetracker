    "heatmap.settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the default range and tasks shown in Today. Every selection includes its subtasks. Repeating occurrences roll up to their parent; ordinary parent and child selections remain separate Heatmaps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Today 中热力图的默认范围和任务。每项选择都会包含其子任务；重复生成的子任务汇总到父任务，普通父子任务仍可分别显示热力图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Today 中熱力圖的預設範圍和任務。每項選擇都會包含其子任務；重複產生的子任務會彙總到父任務，普通父子任務仍可分別顯示熱力圖。"
          }
        }
      }
