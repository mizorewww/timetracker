    "settings.data.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON exports your source records and synced preferences. The file may contain sensitive data; store it securely. Rebuildable analytics caches and sync checkpoints are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 会导出用户原始记录和同步偏好。文件可能包含敏感数据，请妥善保存。可重建的分析缓存和同步检查点不包含在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 會匯出使用者原始記錄和同步偏好。檔案可能包含敏感資料，請妥善保存。可重建的分析快取和同步檢查點不包含在內。"
          }
        }
      }
    },
    "settings.displayTiming": {
