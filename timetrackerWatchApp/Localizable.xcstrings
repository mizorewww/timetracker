        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试不会重复执行已完成的操作；丢弃只会隐藏此提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試不會重複執行已完成的操作；捨棄只會隱藏此提示。"
