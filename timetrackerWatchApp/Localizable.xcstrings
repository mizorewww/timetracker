    "watch.active.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the Digital Crown to open Quick Start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转数码表冠即可打开“快速开始”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旋轉數位錶冠即可開啟「快速開始」。"
          }
        }
      }
    },
